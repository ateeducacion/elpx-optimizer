{
  "name": "elpx-optimizer",
  "version": "0.2.3",
  "description": "Analyze and shrink eXeLearning .elpx projects: recompress videos and images, detect missing, unused and duplicate resources. CLI, static in-browser web app and Agent Skill.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ateeducacion/elpx-optimizer.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "bin": {
    "elpx-optimizer": "dist/cli/elpx-optimizer.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run build:web && bun run build:cli",
    "build:web": "vite build",
    "build:cli": "bun scripts/build-cli.ts",
    "serve": "bun src/cli/bin.ts serve",
    "cli": "bun src/cli/bin.ts",
    "typecheck": "bun check -p tsconfig.core.json && bun check -p tsconfig.node.json && bun check -p tsconfig.web.json && bun check -p tsconfig.json",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:bun": "bun test test/bun",
    "coverage": "vitest run --coverage",
    "test:e2e": "bunx --bun playwright test",
    "fixtures": "node scripts/generate-media-fixtures.mjs && bun scripts/generate-elpx-fixtures.ts",
    "skill:validate": "bun scripts/validate-skill.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-mt": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@neslinesli93/qpdf-wasm": "0.3.1",
    "@noble/hashes": "2.4.0",
    "bootstrap": "5.3.9",
    "bootstrap-icons": "1.13.2",
    "entities": "9.0.0",
    "fflate": "0.8.3",
    "parse5": "8.1.1",
    "pdfjs-dist": "6.5.438",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "playwright": "1.65.0",
    "sass": "1.108.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
